# FaultShield Environment Variables
# Nebius Token Factory API Configuration

# Obtain key from https://tokenfactory.nebius.ai/
# Hackathon Promo Code: NEBIUS-DEVPOST-GLOBAL26 ($25 credit)
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL (default: https://api.tokenfactory.nebius.com/v1/)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Target Model
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
